@startuml overview
title How bed presence reaches home
skinparam shadowing false
skinparam componentStyle rectangle

node "Bed" {
  [Withings Sleep] as sensor
}
cloud "Internet" {
  [Withings API] as withings
  [Relay (Cloudflare Worker)] as relay
  database "Stored notifications" as store
}
node "Home server (no inbound from the internet)" {
  [press-start] as app
  database "Latest bed state" as state
}

sensor --> withings : bed in / bed out
withings --> relay : notification (HTTPS)
relay --> store : keep
app --> relay : fetch (outbound only)
app --> state : keep across restarts
@enduml
